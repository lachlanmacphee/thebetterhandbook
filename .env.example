# The Go app reads these from the environment. For local development:
#   set -a; source .env; set +a; go run ./cmd/tbh

# SQLite database file (created on first run) and listen address.
DATABASE_PATH=data/tbh.db
ADDR=:3000

# "development" logs sign-in codes, logs emails instead of sending them when
# EMAIL_HOST is empty, and drops the Secure flag from cookies.
ENV=development

# Required in production. Keys the HMAC used to store sign-in codes.
SESSION_SECRET=

# SMTP with implicit TLS (port 465).
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# Importers: University of Sydney needs a bearer token copied from the browser
# network tab on its search page. Monash's Next.js build ID changes over time.
USYD_BEARER_TOKEN=
MONASH_HANDBOOK_BUILD_ID=
